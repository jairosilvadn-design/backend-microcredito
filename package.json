{
  "name": "microcredito-backend",
  "version": "0.8.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "test": "tsx tests/audit.test.ts && tsx tests/correcoes.test.ts && tsx tests/ledger.test.ts",
    "test:db": "tsx tests/ledger.db.test.ts && DB_TEST_URL=$DATABASE_URL tsx tests/http.db.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.1.1",
    "@netlify/database": "^2.0.1",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.28.2",
    "pino": "^10.4.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
