NODE_ENV=development
PORT=3333
ENABLE_JOBS=true                 # ligue em UMA instância só

# Supabase / Postgres
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Mercado Pago (aplicação Marketplace da conta matriz)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://api.seudominio.com.br/oauth/mercadopago/callback
MP_AUTH_BASE_URL=https://auth.mercadopago.com.br/authorization
MP_WEBHOOK_SECRET=               # "assinatura secreta" da tela de Webhooks
MP_PLATFORM_ACCESS_TOKEN=        # token de produção da conta matriz
MP_PLATFORM_USER_ID=             # user_id da conta matriz

# Criptografia dos tokens: lista kid:chaveBase64(32 bytes). Gere com: npm run gen:key
TOKEN_ENC_KEYS=v1:COLE_AQUI_A_CHAVE_BASE64
TOKEN_ENC_ACTIVE_KID=v1

# Regras
OAUTH_STATE_TTL_HOURS=48         # link de vinculação vai por WhatsApp
TOKEN_REFRESH_WINDOW_DAYS=30     # renova quando faltar menos que isso
APP_PUBLIC_URL=https://app.seudominio.com.br

# Firebase Auth (login Google dos operadores)
FIREBASE_PROJECT_ID=seu-projeto-firebase

# CORS: domínios do painel no Netlify (sem barra no final)
CORS_ORIGINS=https://painel.seudominio.com.br,https://seu-site.netlify.app
# Opcional: libera deploy previews do Netlify
CORS_ORIGIN_REGEX=^https://deploy-preview-\d+--seu-site\.netlify\.app$

# Cobranças
PIX_DEFAULT_PAYER_EMAIL=pagador@seudominio.com.br
PIX_BALCAO_EXPIRATION_MINUTES=30
LINK_EXPIRATION_HOURS=24
AVULSA_EXPIRATION_HOURS=24

# Auditoria diária
AUDIT_CRON=0 6 * * *
AUDIT_BACKFILL_DAYS=7
BYPASS_MIN_AMOUNT=10
BYPASS_MIN_COUNT=1

# WhatsApp Cloud API (opcional; deixe vazio para envio manual pelo link wa.me)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_COBRANCA=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v21.0
