# Este arquivo vive SOMENTE no servidor do robô (Railway/Render/Fly/Cloud Run: "Environment variables" / Secret Manager).
# Nunca no Netlify do front, nunca no GitHub. Copie para .env apenas em desenvolvimento local (.env está no .gitignore).
ITAU_URL_LOGIN=https://URL-DO-PORTAL-DO-CORRESPONDENTE
ITAU_URL_PROPOSTA=
# Deixe 'false' até validar o preenchimento com um humano olhando (HEADLESS=false). 'true' = o robô ENVIA propostas de verdade.
PROPOSTA_ENVIO_HABILITADO=false
ITAU_URL_SIMULADOR=
# ITAU_USUARIO é o E-MAIL de acesso ao portal
ITAU_USUARIO=
ITAU_SENHA=
ITAU_CODIGO_CORRESPONDENTE=
# Service account do Firebase: cole o conteúdo do arquivo .json inteiro (ou em base64)
FIREBASE_SERVICE_ACCOUNT_B64=
# Itaú costuma bloquear sessões simultâneas da mesma credencial: comece com 1.
ROBO_CONCURRENCY=1
ROBO_TIMEOUT_MS=60000
ROBO_MAX_TENTATIVAS=3
ROBO_LOCK_TTL_MS=300000
HEADLESS=true
